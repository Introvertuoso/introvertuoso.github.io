<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      <div class="navbar-brand-wrapper d-inline-flex align-items-center">
        {% if page.permalink != '/' and page.url != '/' and page.permalink != nil %}
          <a class="navbar-brand title font-weight-lighter" href="{{ site.baseurl }}/" title="{{ site.first_name }} {{ site.last_name }}">
            <!-- Desktop: Name only (bold first name, no logo) -->
            <span class="d-none d-sm-inline">{% if site.first_name %}<span class="font-weight-bold">{{ site.first_name }}</span> {% endif %}{% if site.middle_name %}{{ site.middle_name }} {% endif %}{% if site.last_name %}{{ site.last_name }}{% endif %}</span>
            <!-- Mobile: Logo only (replaces name) -->
            <div class="navbar-brand-logo d-inline-flex d-sm-none">
              <img src="{{ '/assets/img/logo_dark.png' | relative_url }}" alt="Logo" class="navbar-logo-img logo-dark">
              <img src="{{ '/assets/img/logo_light.png' | relative_url }}" alt="Logo" class="navbar-logo-img logo-light">
            </div>
          </a>
        {% endif %}
        <div class="navbar-brand-social d-inline-flex align-items-center">
          {% if site.orcid_id %}
            <a class="brand-social-icon" href="https://orcid.org/{{ site.orcid_id }}" title="ORCID" target="_blank" rel="noopener noreferrer">
              <i class="ai ai-orcid"></i>
            </a>
          {% endif %}
          {% if site.email %}
            <a class="brand-social-icon" href="mailto:{{ site.email | encode_email }}" title="Email" target="_blank" rel="noopener noreferrer">
              <i class="fa-solid fa-envelope"></i>
            </a>
          {% endif %}
          {% if site.scholar_userid %}
            <a class="brand-social-icon" href="https://scholar.google.com/citations?user={{ site.scholar_userid }}" title="Google Scholar" target="_blank" rel="noopener noreferrer">
              <i class="ai ai-google-scholar"></i>
            </a>
          {% endif %}
          {% if site.linkedin_username %}
            <a class="brand-social-icon" href="https://www.linkedin.com/in/{{ site.linkedin_username }}" title="LinkedIn" target="_blank" rel="noopener noreferrer">
              <i class="fa-brands fa-linkedin"></i>
            </a>
          {% endif %}
          {% if site.x_username %}
            <a class="brand-social-icon" href="https://twitter.com/{{ site.x_username }}" title="X" target="_blank" rel="noopener noreferrer">
              <i class="fa-brands fa-x-twitter"></i>
            </a>
          {% endif %}
        </div>
      </div>
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse text-right" id="navbarNav">
        <ul class="navbar-nav ml-auto">
          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-toggle="dropdown"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- p.title }}
                    {% if page.title == p.title or has_active_child %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a class="dropdown-item {% if page.title == child.title %}active{% endif %}" href="{{ child.permalink | relative_url }}">
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                {% assign parent_link = p.permalink | remove: 'index.html' %}
                <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                  {% if p.permalink contains '/blog/' %}
                    {% assign url = '/blog/' %}
                    <a class="nav-link" href="{{ url | relative_url }}">
                      {{- p.title }}
                    </a>
                  {% elsif p.cv_pdf %}
                    <a class="nav-link" href="{{ p.cv_pdf | prepend: '/assets/pdf/' | relative_url }}" target="_blank" rel="noopener noreferrer">
                      {{- p.title }}
                    </a>
                  {% elsif p.redirect %}
                    <a class="nav-link" href="{{ p.redirect | relative_url }}" target="_blank" rel="noopener noreferrer">
                      {{- p.title }}
                    </a>
                  {% else %}
                    {% assign url = p.url %}
                    <a class="nav-link" href="{{ url | relative_url }}">
                      {{- p.title }}
                      {% if page.url contains p.url %}
                        <span class="sr-only">(current)</span>
                      {% endif %}
                    </a>
                  {% endif %}
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item search-container">
              <button id="search-toggle" title="Search (Ctrl + K)" onclick="openSearchModal()">
                <i class="ti ti-search"></i>
              </button>
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <!-- Toggle theme mode -->
            <li class="nav-item toggle-container">
              <button id="light-toggle" title="Change theme">
                <i class="ti ti-sun-moon" id="light-toggle-system"></i>
                <i class="ti ti-moon-filled" id="light-toggle-dark"></i>
                <i class="ti ti-sun-filled" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
