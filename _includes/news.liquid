<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div class="news-table-wrapper">
      <table class="table table-sm table-borderless">
        {% assign news = site.news | reverse %}
        {% for item in news %}
          <tr class="news-entry {% if include.limit and forloop.index > 5 %}more-news-item d-none{% endif %}">
            <th scope="row">{{ item.date | date: '%b, %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
      {% if include.limit and news_size > 5 %}
        <script>
          var _newsCollapseTimeout = null;
          function toggleMoreNews(btn) {
            var section = document.querySelector('.news');
            if (!section) return;
            var wrapper = section.querySelector('.news-table-wrapper');
            if (!wrapper) return;
            var hiddenRows = section.querySelectorAll('.more-news-item');
            var isExpanded = btn.getAttribute('aria-expanded') === 'true';

            if (_newsCollapseTimeout) {
              clearTimeout(_newsCollapseTimeout);
              _newsCollapseTimeout = null;
            }

            var animEasing = 'cubic-bezier(0.22, 1, 0.36, 1)';

            if (isExpanded) {
              btn.setAttribute('aria-expanded', 'false');
              btn.setAttribute('title', 'Show more announcements');

              var currentHeight = wrapper.offsetHeight;
              wrapper.style.transition = 'none';
              wrapper.style.height = currentHeight + 'px';
              wrapper.style.overflow = 'hidden';

              var targetHeight = wrapper._collapsedHeight;
              var baseRows = section.querySelectorAll('tr.news-entry:not(.more-news-item)');
              if (baseRows.length > 0) {
                var table = wrapper.querySelector('table');
                var tableRect = table ? table.getBoundingClientRect() : wrapper.getBoundingClientRect();
                var lastRowRect = baseRows[baseRows.length - 1].getBoundingClientRect();
                var measuredHeight = Math.round(lastRowRect.bottom - tableRect.top);
                if (!targetHeight || Math.abs(targetHeight - measuredHeight) > 10) {
                  targetHeight = measuredHeight;
                }
              }
              if (!targetHeight || targetHeight <= 0) {
                targetHeight = 150;
              }

              var total = hiddenRows.length;
              hiddenRows.forEach(function(row, idx) {
                row.classList.remove('unravel-in');
                var reverseIdx = (total - 1) - idx;
                row.style.animationDelay = (reverseIdx * 30) + 'ms';
                row.classList.add('ravel-out');
              });

              void wrapper.offsetHeight;
              var duration = 480;
              wrapper.style.transition = 'height ' + duration + 'ms ' + animEasing;
              wrapper.style.height = targetHeight + 'px';

              _newsCollapseTimeout = setTimeout(function() {
                if (btn.getAttribute('aria-expanded') === 'false') {
                  hiddenRows.forEach(function(row) {
                    row.classList.add('d-none');
                    row.classList.remove('ravel-out');
                    row.style.animationDelay = '';
                  });
                  wrapper.style.height = '';
                  wrapper.style.transition = '';
                }
              }, duration);
            } else {
              btn.setAttribute('aria-expanded', 'true');
              btn.setAttribute('title', 'Show fewer announcements');

              var startHeight = wrapper.offsetHeight;
              wrapper._collapsedHeight = startHeight;
              wrapper.style.transition = 'none';
              wrapper.style.height = startHeight + 'px';
              wrapper.style.overflow = 'hidden';

              hiddenRows.forEach(function(row, idx) {
                row.classList.remove('d-none');
                row.classList.remove('ravel-out');
                row.style.animationDelay = (idx * 45) + 'ms';
                row.classList.add('unravel-in');
              });

              var table = wrapper.querySelector('table');
              var targetHeight = Math.max(wrapper.scrollHeight, table ? table.offsetHeight : 0);

              void wrapper.offsetHeight;
              var duration = 520;
              wrapper.style.transition = 'height ' + duration + 'ms ' + animEasing;
              wrapper.style.height = targetHeight + 'px';

              _newsCollapseTimeout = setTimeout(function() {
                if (btn.getAttribute('aria-expanded') === 'true') {
                  wrapper.style.height = '';
                  wrapper.style.transition = '';
                }
              }, duration + 50);
            }
          }
        </script>
      {% endif %}
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
