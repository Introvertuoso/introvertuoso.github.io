---
layout: default
---
<div class="post">
  <header class="post-header {% if page.header_card %}with-header-card{% endif %}">
    <div class="post-header-info">
      <h1 class="post-title">{{ page.title }}</h1>
      <p class="post-description">{{ page.description }}</p>
    </div>
    {% if page.header_card %}
      <div class="header-side-card">
        {% if page.header_card == 'scholar' %}
          {% assign total_citations = 0 %}
          {% if site.data.citations and site.data.citations.citations %}
            {% for item in site.data.citations.citations %}
              {% assign total_citations = total_citations | plus: item[1] %}
            {% endfor %}
          {% endif %}
          <a href="https://scholar.google.com/citations?user={{ site.scholar_userid }}" target="_blank" class="metric-item">
            <div class="metric-icon">
              <i class="ai ai-google-scholar"></i>
            </div>
            <div class="metric-text">
              <span class="metric-value">{% if total_citations > 0 %}{{ total_citations }}+ Citations{% else %}76+ Citations{% endif %}</span>
              <span class="metric-label">Google Scholar</span>
            </div>
          </a>
        {% elsif page.header_card == 'orcid' %}
          {% assign peer_reviews = site.data.citations.peer_reviews_count | default: 25 %}
          <a href="https://orcid.org/{{ site.orcid_id }}" target="_blank" class="metric-item">
            <div class="metric-icon">
              <i class="fa-solid fa-clipboard-check"></i>
            </div>
            <div class="metric-text">
              <span class="metric-value">{{ peer_reviews }} Peer Reviews</span>
              <span class="metric-label">Verified via ORCID</span>
            </div>
          </a>
        {% endif %}
      </div>
    {% endif %}
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
